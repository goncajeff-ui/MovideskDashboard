    private void ApplyQuickStatus(string statusKey)
    {
        if (statusKey == "ALL")
        {
            _filter.Status = "ALL";
            _filter.Urgencia = "ALL";
            _filter.UrgenciaGrupo = "ALL";
        }
        else
        {
            _filter.Status = _filter.Status == statusKey ? "ALL" : statusKey;
        }
