    private void ToggleHighCriticalGroup() =>
        _filter.UrgenciaGrupo = _filter.UrgenciaGrupo == "HIGH_CRIT" ? "ALL" : "HIGH_CRIT";

    private void ToggleClientFilter(string cliente) =>
        _filter.Cliente = string.Equals(_filter.Cliente, cliente, StringComparison.Ordinal) ? "ALL" : cliente;

    private void ToggleServiceFilter(string servico) =>
        _filter.Servico = string.Equals(_filter.Servico, servico, StringComparison.Ordinal) ? "ALL" : servico;

    private void ToggleStatusFilter(string status) =>
        _filter.Status = string.Equals(_filter.Status, status, StringComparison.Ordinal) ? "ALL" : status;

    private void ToggleUrgencyFilter(string urgencia)
    {
        _filter.UrgenciaGrupo = "ALL";
        _filter.Urgencia = string.Equals(_filter.Urgencia, urgencia, StringComparison.Ordinal) ? "ALL" : urgencia;
    }

    private void ResetFilters()
    {
        _filter.Cliente = "ALL";
        _filter.Servico = "ALL";
        _filter.Status = "ALL";
        _filter.Urgencia = "ALL";
        _filter.UrgenciaGrupo = "ALL";
        _filter.SearchText = string.Empty;
        _filter.SortMode = CarteiraSortMode.Alpha;
