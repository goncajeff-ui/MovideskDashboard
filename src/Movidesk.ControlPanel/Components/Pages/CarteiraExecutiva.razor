    private static List<ScatterTag> BuildNonOverlappingScatterTags(
        IReadOnlyList<ClientPortfolioRow> items,
        double maxX,
        double maxY)
    {
        var tags = new List<ScatterTag>();
        var offsets = new (double Dx, double Dy)[]
        {
            (0.0, 0.0),
            (7.5, -2.5),
            (-7.5, -2.5),
            (0.0, -7.5),
            (10.0, -6.5),
            (0.0, 8.0),
            (11.0, 2.0)
        };

        foreach (var item in items)
        {
            if (!item.AvgCadenceDays.HasValue) continue;
            double cad = item.AvgCadenceDays.Value;
            if (cad >= 15.0 && item.RecencyDays < 80 && item.PendingCount == 0) continue;

            double baseX = 8.0 + (item.RecencyDays / maxX) * 84.0;
            double baseY = 88.0 - (cad / maxY) * 74.0;

            foreach (var (dx, dy) in offsets)
            {
                double candX = Math.Clamp(baseX + dx, 9.0, 89.0);
                double candY = Math.Clamp(baseY + dy, 12.0, 90.0);

                bool overlaps = tags.Any(t =>
                    Math.Abs(t.LeftPct - candX) < 16.0 &&
                    Math.Abs(t.TopPct - candY) < 6.8);

                if (!overlaps)
                {
                    tags.Add(new ScatterTag($"{item.ShortName} ({Fmt1(cad)}d)", candX, candY));
                    break;
                }
            }
        }

        return tags;
    }

    private static List<HighlightSegment> SplitForHighlight(string text, string query)
    {
        var result = new List<HighlightSegment>();
        if (string.IsNullOrEmpty(text))
        {
            return result;
        }

        var needle = query.Trim();
        if (string.IsNullOrEmpty(needle))
        {
            result.Add(new HighlightSegment(text, false));
            return result;
        }

        int pos = 0;
        while (pos < text.Length)
        {
            int idx = text.IndexOf(needle, pos, StringComparison.OrdinalIgnoreCase);
            if (idx < 0)
            {
                result.Add(new HighlightSegment(text[pos..], false));
                break;
            }

            if (idx > pos)
            {
                result.Add(new HighlightSegment(text[pos..idx], false));
            }

            result.Add(new HighlightSegment(text.Substring(idx, needle.Length), true));
            pos = idx + needle.Length;
        }

        return result;
    }

    private static int GetPlatformOrder(string servico) => servico switch
    {
        "EGUARDIAN" => 1,
        "KN1" => 2,
        "CCS" => 3,
        "METIS (GESTOR DE RISCOS)" => 4,
        "CORPORATIVO" => 5,
        "Listas e CheckPEP" => 6,
        _ => 99
    };

    private static string GetRecencyColor(int days) => days >= 80 ? "#EF4444" : days >= 30 ? "#F59E0B" : "#10B981";
    private static string GetRecencyCssClass(int days) => days >= 80 ? "sem-red" : days >= 30 ? "sem-amber" : "sem-green";

    private static string GetCadenceColor(double days) =>
        days < 7.0 ? "#EF4444" :
        days < 15.0 ? "#F97316" :
        days <= 45.0 ? "#3B82F6" : "#64748B";

    private static string GetStatusBadgeCssClass(string status) => status switch
    {
        "Resolvido" => "st-resolvido",
        "Fechado" => "st-fechado",
        "Aguardando" => "st-aguardando",
        "Em atendimento" => "st-atendimento",
        _ => "st-cancelado"
    };

    private static string GetUrgencyBadgeCssClass(string urgencia) => urgencia switch
    {
        "Crítica/Impeditiva" => "urg-critica",
        "Alta" => "urg-alta",
        "Média" => "urg-media",
        _ => "urg-baixa"
    };

    private static string Inv(double value) => value.ToString("F2", CultureInfo.InvariantCulture);
    private static string Fmt1(double value) => value.ToString("N1", CarteiraExecutivaService.PtBr);
    private static string Fmt2(double value) => value.ToString("N2", CarteiraExecutivaService.PtBr);
    private static string Fmt0Or1(double value) =>
        Math.Abs(value - Math.Round(value)) < 0.0001
            ? Math.Round(value).ToString("N0", CarteiraExecutivaService.PtBr)
            : value.ToString("N1", CarteiraExecutivaService.PtBr);
