@page "/"
@inject SupersetService SupersetService
@inject DatabaseMonitorService DbMonitor
@inject MovideskIngestionService IngestionService
@implements IDisposable

<PageTitle>Painel de Controle — Movidesk BI</PageTitle>

<div class="dashboard-wrapper">
    <!-- Cabeçalho Principal -->
    <header class="top-header">
        <div class="brand-block">
            <div class="brand-icon">BI</div>
            <div>
                <h1>Painel de Controle — Movidesk BI</h1>
                <p class="subtitle">Orquestração de Infraestrutura · Apache Superset (WSL2) · SQL Server (MovideskDM) · API Movidesk</p>
            </div>
        </div>

        <div class="header-badges">
            <span class="badge @GetSupersetBadgeClass()">
                @if (SupersetService.Status == SupersetStatus.Starting)
                {
                    <span class="spinner spinner-sm" aria-hidden="true"></span>
                }
                else
                {
                    <span class="status-dot" aria-hidden="true"></span>
                }
                Superset: @GetSupersetStatusText()
            </span>

            <span class="badge @(_volumetria?.Conectado == true ? "badge-online" : "badge-error")">
                <span class="status-dot" aria-hidden="true"></span>
                MovideskDM: @(_volumetria is null ? "Verificando..." : _volumetria.Conectado ? "Conectado" : "Desconectado")
            </span>
        </div>
    </header>

    <!-- Grid Superior: Launcher Superset + Monitor de Volumetria -->
    <div class="dashboard-grid">
        <!-- ===============================================================
             CARD 1: LAUNCHER DO APACHE SUPERSET (WSL2)
             =============================================================== -->
        <section class="card">
            <div class="card-header">
                <div class="card-title-group">
                    <h2>1. Launcher do Apache Superset</h2>
                    <span class="card-subtitle">Execução silenciosa no Windows via <code>wsl.exe</code> em background</span>
                </div>
                <span class="badge @GetSupersetBadgeClass()">
                    @if (SupersetService.Status == SupersetStatus.Starting)
                    {
                        <span class="spinner spinner-sm" aria-hidden="true"></span>
                    }
                    else
                    {
                        <span class="status-dot" aria-hidden="true"></span>
                    }
                    @GetSupersetStatusText()
                </span>
            </div>

            <div class="card-body">
                <div class="meta-row">
                    <span class="meta-chip"><strong>Distro:</strong> @SupersetService.WslDistro</span>
                    <span class="meta-chip"><strong>Venv WSL:</strong> <code>@SupersetService.VenvActivatePath</code></span>
                    <span class="meta-chip"><strong>Porta:</strong> @SupersetService.Port</span>
                </div>

                <div class="status-banner @(SupersetService.Status == SupersetStatus.Error ? "status-banner-error" : SupersetService.Status == SupersetStatus.Online ? "status-banner-ok" : "")">
                    @if (SupersetService.Status == SupersetStatus.Starting)
                    {
                        <span class="spinner" aria-hidden="true"></span>
                    }
                    <span>@SupersetService.StatusMessage</span>
                </div>

                <div class="actions-row">
                    <button type="button"
                            class="btn btn-primary"
                            @onclick="IniciarSupersetAsync"
                            disabled="@(SupersetService.Status == SupersetStatus.Starting || SupersetService.Status == SupersetStatus.Online)">
                        @if (SupersetService.Status == SupersetStatus.Starting)
                        {
                            <span class="spinner spinner-sm" aria-hidden="true"></span>
                            <span>Subindo servidor...</span>
                        }
                        else
                        {
                            <span>Iniciar Superset (WSL2)</span>
                        }
                    </button>

                    @if (SupersetService.Status == SupersetStatus.Online)
                    {
                        <button type="button"
                                class="btn btn-success"
                                @onclick="SupersetService.OpenInBrowser">
                            Abrir Superset ↗
                        </button>
                    }

                    <button type="button"
                            class="btn btn-secondary"
                            @onclick="VerificarSupersetAsync"
                            disabled="@_verificandoSuperset">
                        @(_verificandoSuperset ? "Verificando..." : "Verificar Status")
                    </button>

                    <button type="button"
                            class="btn btn-danger"
                            @onclick="PararSupersetAsync"
                            disabled="@(SupersetService.Status == SupersetStatus.Offline)">
                        Parar Superset
                    </button>
                </div>

                @{
                    var supersetLogs = SupersetService.GetLogsSnapshot();
                }
                <div class="console-box console-box-compact">
                    <div class="console-header">
                        <span>Log WSL / Superset</span>
                        <span class="muted">@supersetLogs.Count linha(s)</span>
                    </div>
                    <div class="console-log">
                        @if (supersetLogs.Count == 0)
                        {
                            <div class="log-empty">Clique em "Iniciar Superset (WSL2)" para subir o servidor na porta @SupersetService.Port.</div>
                        }
                        else
                        {
                            @foreach (var line in supersetLogs.AsEnumerable().Reverse())
                            {
                                <div class="log-line @GetLogCssClass(line)">@line</div>
                            }
                        }
                    </div>
                </div>
            </div>
        </section>

        <!-- ===============================================================
             CARD 2: MONITOR DE VOLUMETRIA (MSSQL MovideskDM + Dapper)
             =============================================================== -->
        <section class="card">
            <div class="card-header">
                <div class="card-title-group">
                    <h2>2. Monitor de Volumetria (MovideskDM)</h2>
                    <span class="card-subtitle">Contagem em tempo real via Dapper (<code>SELECT COUNT(*) FROM core.Fato_Ticket</code>)</span>
                </div>
                <span class="muted timestamp-label">
                    Atualizado: @(_volumetria?.ConsultadoEm.ToString("HH:mm:ss") ?? "--:--:--")
                </span>
            </div>

            <div class="card-body">
                @if (_volumetria is { Conectado: false })
                {
                    <div class="alert-error">
                        <strong>Falha ao conectar no SQL Server (MovideskDM):</strong>
                        <span>@_volumetria.MensagemErro</span>
                        <small>Verifique a ConnectionString no arquivo <code>appsettings.json</code> ao lado do executável.</small>
                    </div>
                }

                <div class="metric-hero">
                    <span class="metric-label">Chamados Importados e Processados no Data Mart</span>
                    <div class="metric-big">
                        @if (_volumetria is { Conectado: true })
                        {
                            @_volumetria.TotalTicketsCore.ToString("N0")
                        }
                        else
                        {
                            <span>--</span>
                        }
                    </div>
                    <span class="metric-caption">Tabela <code>core.Fato_Ticket</code> pronta para consulta no Superset</span>
                </div>

                <div class="sub-metrics-grid">
                    <div class="mini-metric">
                        <span class="mini-label">RAW Total (<code>raw.Ticket</code>)</span>
                        <strong class="mini-value">
                            @(_volumetria?.Conectado == true ? _volumetria.TotalTicketsRaw.ToString("N0") : "--")
                        </strong>
                    </div>

                    <div class="mini-metric">
                        <span class="mini-label">Empresas / Contatos Vinculados</span>
                        <strong class="mini-value mini-value-sm">
                            @if (_volumetria?.Conectado == true)
                            {
                                @($"{_volumetria.TotalEmpresasClientes:N0} emp. / {_volumetria.TotalContatosVinculados:N0} vínc.")
                            }
                            else
                            {
                                @("--")
                            }
                        </strong>
                    </div>

                    <div class="mini-metric">
                        <span class="mini-label">Faixa de Tickets (#ID)</span>
                        <strong class="mini-value mini-value-sm">
                            @if (_volumetria?.MenorTicketId is int minId && _volumetria?.UltimoTicketId is int maxId)
                            {
                                @($"#{minId} → #{maxId}")
                            }
                            else
                            {
                                @("--")
                            }
                        </strong>
                    </div>

                    <div class="mini-metric">
                        <span class="mini-label">Fronteira Histórica / Snapshot</span>
                        <strong class="mini-value mini-value-sm">
                            @if (_volumetria?.Conectado == true)
                            {
                                @($"{_volumetria.FronteiraHistoricaUtc?.ToString("dd/MM/yyyy HH:mm") ?? "--"} ({_volumetria.TotalDiasSnapshot}d)")
                            }
                            else
                            {
                                @("--")
                            }
                        </strong>
                    </div>
                </div>

                <div class="actions-row actions-between">
                    <button type="button"
                            class="btn btn-secondary"
                            @onclick="() => AtualizarVolumetriaAsync()"
                            disabled="@_atualizandoVolumetria">
                        @if (_atualizandoVolumetria)
                        {
                            <span class="spinner spinner-sm" aria-hidden="true"></span>
                            <span>Consultando SQL Server...</span>
                        }
                        else
                        {
                            <span>Atualizar Agora</span>
                        }
                    </button>

                    <label class="checkbox-toggle">
                        <input type="checkbox" @bind="_autoRefresh" />
                        <span>Auto-refresh (5s)</span>
                    </label>
                </div>
            </div>
        </section>

        <!-- ===============================================================
             CARD: CONFIGURAÇÃO INICIAL DO SUPERSET (AUTOMAÇÃO PYTHON / WSL2)
             =============================================================== -->
        <section class="card card-full">
            <div class="card-header">
                <div class="card-title-group">
                    <h2>Configuração Inicial do Superset</h2>
                    <span class="card-subtitle">Provisiona automaticamente a Database Connection (<code>MovideskDM</code>), os 8 Datasets (<code>schema mart</code>) e o Dashboard <strong>Sala de Guerra</strong></span>
                </div>
                <span class="badge @GetSupersetSetupBadgeClass()">
                    @if (SupersetService.IsSetupRunning)
                    {
                        <span class="spinner spinner-sm" aria-hidden="true"></span>
                    }
                    else
                    {
                        <span class="status-dot" aria-hidden="true"></span>
                    }
                    @GetSupersetSetupBadgeText()
                </span>
            </div>

            <div class="card-body">
                <div class="status-banner @(SupersetService.SetupSucceeded == false ? "status-banner-error" : SupersetService.SetupSucceeded == true ? "status-banner-ok" : "")">
                    @if (SupersetService.IsSetupRunning)
                    {
                        <span class="spinner" aria-hidden="true"></span>
                    }
                    <span>@SupersetService.SetupStatusMessage</span>
                </div>

                <div class="controls-row">
                    <div class="actions-row" style="align-items: flex-end;">
                        <div class="input-group">
                            <label for="superset-admin-pass">Senha do usuário <code>admin</code> (Superset)</label>
                            <input id="superset-admin-pass"
                                   type="password"
                                   class="input-control"
                                   style="width: 260px;"
                                   placeholder="Digite a senha do admin..."
                                   @bind="_supersetAdminPassword"
                                   @bind:event="oninput"
                                   disabled="@SupersetService.IsSetupRunning" />
                        </div>

                        <button type="button"
                                class="btn btn-primary"
                                @onclick="ExecutarSetupSupersetAsync"
                                disabled="@SupersetService.IsSetupRunning">
                            @if (SupersetService.IsSetupRunning)
                            {
                                <span class="spinner spinner-sm" aria-hidden="true"></span>
                                <span>Executando Setup Automático...</span>
                            }
                            else
                            {
                                <span>Executar Setup Automático</span>
                            }
                        </button>

                        @if (SupersetService.SetupSucceeded == true || SupersetService.Status == SupersetStatus.Online)
                        {
                            <button type="button"
                                    class="btn btn-success"
                                    @onclick="SupersetService.OpenDashboardInBrowser">
                                Abrir Sala de Guerra ↗
                            </button>
                        }

                        <button type="button"
                                class="btn btn-ghost"
                                @onclick="SupersetService.ClearSetupLogs"
                                disabled="@SupersetService.IsSetupRunning">
                            Limpar Console
                        </button>
                    </div>

                    <div class="meta-row">
                        <span class="meta-chip"><strong>1. Database:</strong> <code>MovideskDM</code> (MSSQL)</span>
                        <span class="meta-chip"><strong>2. Datasets:</strong> 8 Views <code>mart.vw_*</code></span>
                        <span class="meta-chip"><strong>3. Dashboard:</strong> Sala de Guerra (13 gráficos)</span>
                    </div>
                </div>

                @{
                    var setupLogs = SupersetService.GetSetupLogsSnapshot();
                }
                <div class="console-box console-box-compact">
                    <div class="console-header">
                        <span>Console do Setup Automático do Superset (stdout / stderr via WSL2)</span>
                        <span class="muted">@setupLogs.Count linha(s)</span>
                    </div>
                    <div class="console-log">
                        @if (setupLogs.Count == 0)
                        {
                            <div class="log-empty">
                                Digite a senha do usuário <code>admin</code> do Apache Superset e clique em "Executar Setup Automático" para criar a conexão MovideskDM, registrar as 8 views do schema mart e publicar o Dashboard Sala de Guerra.
                            </div>
                        }
                        else
                        {
                            @foreach (var line in setupLogs.AsEnumerable().Reverse())
                            {
                                <div class="log-line @GetLogCssClass(line)">@line</div>
                            }
                        }
                    </div>
                </div>
            </div>
        </section>

        <!-- ===============================================================
             CARD 3: ORQUESTRADOR DE CARGA DE DADOS (ANTI-TRAVAMENTO)
             =============================================================== -->
        <section class="card card-full">
            <div class="card-header">
                <div class="card-title-group">
                    <h2>3. Orquestrador de Carga de Dados (Retomada Inteligente Anti-Travamento)</h2>
                    <span class="card-subtitle">Detecta automaticamente os chamados já salvos no banco, sincroniza Empresas (/persons) e continua de onde parou</span>
                </div>
                <span class="badge @GetIngestionBadgeClass()">
                    @if (IngestionService.IsRunning)
                    {
                        <span class="spinner spinner-sm" aria-hidden="true"></span>
                    }
                    else
                    {
                        <span class="status-dot" aria-hidden="true"></span>
                    }
                    @IngestionService.CurrentStageLabel
                </span>
            </div>

            <div class="card-body">
                <div class="ingestion-summary-bar">
                    <div class="summary-item">
                        <span class="summary-label">Modo Ativo</span>
                        <strong class="summary-value">@IngestionService.CurrentJobType</strong>
                    </div>
                    <div class="summary-item">
                        <span class="summary-label">Cursor de Retomada</span>
                        <strong class="summary-value">@IngestionService.CurrentCursorLabel</strong>
                    </div>
                    <div class="summary-item">
                        <span class="summary-label">Novos Inseridos na Sessão</span>
                        <strong class="summary-value" style="color: #34d399;">
                            +@IngestionService.NewInsertedInCurrentRun.ToString("N0") novos
                        </strong>
                    </div>
                    <div class="summary-item">
                        <span class="summary-label">Lidos da API / Atualizados</span>
                        <strong class="summary-value">
                            @IngestionService.ProcessedInCurrentRun.ToString("N0") lidos (@IngestionService.UpdatedInCurrentRun.ToString("N0") atualizados)
                        </strong>
                    </div>
                    <div class="summary-item">
                        <span class="summary-label">Iniciado em</span>
                        <strong class="summary-value">@(IngestionService.StartedAt?.ToString("HH:mm:ss") ?? "--:--:--")</strong>
                    </div>
                </div>

                <div class="controls-row">
                    <div class="meta-row">
                        <span class="meta-chip">
                            <strong>Retomada Automática:</strong>
                            @if (_volumetria?.Conectado == true && _volumetria.TotalTicketsRaw > 0 && _volumetria.FronteiraHistoricaUtc.HasValue)
                            {
                                <span>
                                    Pula os <strong>@_volumetria.TotalTicketsRaw.ToString("N0")</strong> tickets já salvos e continua de
                                    <code>lastUpdate &lt;= @_volumetria.FronteiraHistoricaUtc.Value.ToString("dd/MM/yyyy HH:mm:ss") UTC</code>
                                </span>
                            }
                            else
                            {
                                <span>Pronto para iniciar carga completa</span>
                            }
                        </span>
                    </div>

                    <div class="actions-row">
                        <button type="button"
                                class="btn btn-primary"
                                @onclick="DispararCargaHistoricaAsync"
                                disabled="@IngestionService.IsRunning">
                            @if (IngestionService.IsRunning && IngestionService.CurrentJobType.StartsWith("Carga Histórica", StringComparison.Ordinal))
                            {
                                <span class="spinner spinner-sm" aria-hidden="true"></span>
                                @IngestionService.CurrentStageLabel
                            }
                            else if (_volumetria?.TotalTicketsRaw > 0)
                            {
                                <span>Retomar Carga Histórica (Automático)</span>
                            }
                            else
                            {
                                <span>Disparar Carga Histórica</span>
                            }
                        </button>

                        <button type="button"
                                class="btn btn-accent"
                                @onclick="DispararCargaIncrementalAsync"
                                disabled="@IngestionService.IsRunning">
                            @if (IngestionService.IsRunning && IngestionService.CurrentJobType == "Carga Incremental")
                            {
                                <span class="spinner spinner-sm" aria-hidden="true"></span>
                                @IngestionService.CurrentStageLabel
                            }
                            else
                            {
                                <span>Disparar Carga Incremental</span>
                            }
                        </button>

                        <button type="button"
                                class="btn btn-secondary"
                                @onclick="DispararSincronizacaoEmpresasAsync"
                                disabled="@IngestionService.IsRunning">
                            @if (IngestionService.IsRunning && IngestionService.CurrentJobType.StartsWith("Sincronização de Empresas", StringComparison.Ordinal))
                            {
                                <span class="spinner spinner-sm" aria-hidden="true"></span>
                                @IngestionService.CurrentStageLabel
                            }
                            else
                            {
                                <span>Sincronizar Empresas (/persons)</span>
                            }
                        </button>

                        <button type="button"
                                class="btn btn-danger"
                                @onclick="IngestionService.CancelarCarga"
                                disabled="@(!IngestionService.IsRunning)">
                            Cancelar Carga
                        </button>

                        <button type="button"
                                class="btn btn-ghost"
                                @onclick="IngestionService.ClearLogs"
                                disabled="@IngestionService.IsRunning">
                            Limpar Console
                        </button>
                    </div>
                </div>

                @{
                    var ingestionLogs = IngestionService.GetLogsSnapshot();
                }
                <div class="console-box">
                    <div class="console-header">
                        <span>Console de Execução em Tempo Real (mais recentes no topo)</span>
                        <span class="muted">@ingestionLogs.Count registro(s)</span>
                    </div>
                    <div class="console-log">
                        @if (ingestionLogs.Count == 0)
                        {
                            <div class="log-empty">
                                Use "Sincronizar Empresas (/persons)" para vincular os chamados já importados às suas Empresas reais, ou "Retomar Carga Histórica (Automático)" para continuar importando o histórico.
                            </div>
                        }
                        else
                        {
                            @foreach (var line in ingestionLogs.AsEnumerable().Reverse())
                            {
                                <div class="log-line @GetLogCssClass(line)">@line</div>
                            }
                        }
                    </div>
                </div>
            </div>
        </section>
    </div>
</div>

@code {
    private VolumetriaSnapshot? _volumetria;
    private bool _autoRefresh = true;
    private bool _atualizandoVolumetria;
    private bool _verificandoSuperset;
    private string _supersetAdminPassword = string.Empty;
    private bool _disposed;
    private CancellationTokenSource? _timerCts;

    protected override async Task OnInitializedAsync()
    {
        SupersetService.OnStateChanged += HandleServiceStateChanged;
        IngestionService.OnStateChanged += HandleServiceStateChanged;

        await AtualizarVolumetriaAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        await SupersetService.CheckHealthAsync();

        // Garante que as novas Procedures (Fuso BRT, Snapshot 90d, Pessoas) e as 8 Views mart.* estejam atualizadas no SQL Server
        _ = Task.Run(async () =>
        {
            await IngestionService.GarantirObjetosBancoAtualizadosAsync();
            await AtualizarVolumetriaAsync();
        });

        _timerCts = new CancellationTokenSource();
        _ = RunAutoRefreshLoopAsync(_timerCts.Token);
    }

    private async Task RunAutoRefreshLoopAsync(CancellationToken ct)
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(5));
        try
        {
            while (await timer.WaitForNextTickAsync(ct))
            {
                if (_autoRefresh)
                {
                    await AtualizarVolumetriaAsync(ct);
                    await SupersetService.CheckHealthAsync(ct);
                }
            }
        }
        catch (OperationCanceledException)
        {
            // Encerramento normal ao sair da página
        }
    }

    private async Task AtualizarVolumetriaAsync(CancellationToken ct = default)
    {
        if (_atualizandoVolumetria || _disposed) return;

        _atualizandoVolumetria = true;
        await RefreshUiSafelyAsync();

        try
        {
            _volumetria = await DbMonitor.GetVolumetriaAsync(ct);
        }
        finally
        {
            _atualizandoVolumetria = false;
            await RefreshUiSafelyAsync();
        }
    }

    private Task IniciarSupersetAsync() => SupersetService.StartSupersetAsync();

    private Task PararSupersetAsync() => SupersetService.StopSupersetAsync();

    private async Task ExecutarSetupSupersetAsync()
    {
        await IngestionService.GarantirObjetosBancoAtualizadosAsync();
        await SupersetService.RunAutoSetupAsync(_supersetAdminPassword);
    }

    private async Task VerificarSupersetAsync()
    {
        if (_verificandoSuperset || _disposed) return;

        _verificandoSuperset = true;
        await RefreshUiSafelyAsync();

        try
        {
            await SupersetService.CheckHealthAsync();
        }
        finally
        {
            _verificandoSuperset = false;
            await RefreshUiSafelyAsync();
        }
    }

    private async Task DispararCargaHistoricaAsync()
    {
        if (IngestionService.IsRunning) return;

        await IngestionService.ExecutarCargaHistoricaAsync();
        await AtualizarVolumetriaAsync();
    }

    private async Task DispararCargaIncrementalAsync()
    {
        if (IngestionService.IsRunning) return;

        await IngestionService.ExecutarCargaIncrementalAsync();
        await AtualizarVolumetriaAsync();
    }

    private async Task DispararSincronizacaoEmpresasAsync()
    {
        if (IngestionService.IsRunning) return;

        await IngestionService.ExecutarSincronizacaoEmpresasAsync();
        await AtualizarVolumetriaAsync();
    }

    private void HandleServiceStateChanged()
    {
        if (_disposed) return;
        _ = RefreshUiSafelyAsync();
    }

    private async Task RefreshUiSafelyAsync()
    {
        if (_disposed) return;

        try
        {
            await InvokeAsync(StateHasChanged);
        }
        catch (ObjectDisposedException)
        {
            // Circuito encerrado
        }
        catch (InvalidOperationException)
        {
            // Renderizador indisponível durante encerramento
        }
    }

    private string GetSupersetBadgeClass() => SupersetService.Status switch
    {
        SupersetStatus.Online => "badge-online",
        SupersetStatus.Starting => "badge-starting",
        SupersetStatus.Error => "badge-error",
        _ => "badge-offline"
    };

    private string GetSupersetStatusText() => SupersetService.Status switch
    {
        SupersetStatus.Online => "Online",
        SupersetStatus.Starting => "Subindo servidor...",
        SupersetStatus.Error => "Erro",
        _ => "Offline"
    };

    private string GetSupersetSetupBadgeClass()
    {
        if (SupersetService.IsSetupRunning) return "badge-running";
        if (SupersetService.SetupSucceeded == true) return "badge-online";
        if (SupersetService.SetupSucceeded == false) return "badge-error";
        return "badge-offline";
    }

    private string GetSupersetSetupBadgeText()
    {
        if (SupersetService.IsSetupRunning) return "Configurando...";
        if (SupersetService.SetupSucceeded == true) return "Concluído";
        if (SupersetService.SetupSucceeded == false) return "Erro";
        return "Pronto";
    }

    private string GetIngestionBadgeClass() => IngestionService.CurrentStage switch
    {
        IngestionStage.Extracting or IngestionStage.SavingToDatabase or IngestionStage.ProcessingCore => "badge-running",
        IngestionStage.WaitingRateLimit => "badge-starting",
        IngestionStage.Completed => "badge-online",
        IngestionStage.Error => "badge-error",
        _ => "badge-offline"
    };

    private static string GetLogCssClass(string line)
    {
        if (line.Contains("[OK]", StringComparison.Ordinal)) return "log-ok";
        if (line.Contains("[WRN]", StringComparison.Ordinal) || line.Contains("[AVISO]", StringComparison.Ordinal)) return "log-wrn";
        if (line.Contains("[ERR]", StringComparison.Ordinal) || line.Contains("[ERRO]", StringComparison.Ordinal)) return "log-err";
        if (line.Contains("[INF]", StringComparison.Ordinal) || line.Contains("[INFO]", StringComparison.Ordinal)) return "log-inf";
        return string.Empty;
    }

    public void Dispose()
    {
        _disposed = true;
        SupersetService.OnStateChanged -= HandleServiceStateChanged;
        IngestionService.OnStateChanged -= HandleServiceStateChanged;
        _timerCts?.Cancel();
        _timerCts?.Dispose();
    }
}
